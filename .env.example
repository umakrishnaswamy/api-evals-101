# Copy to .env, fill in, then:  source .env
# Never commit .env (it's in .gitignore).

# W&B / Weave
# Your W&B host. On a Dedicated Cloud or Self-Managed instance this is the URL
# you open W&B at, e.g. https://<your-company>.wandb.io (no trailing slash).
# Weave finds its trace server from it automatically (<host>/traces).
# For the public cloud use https://api.wandb.ai
export WANDB_BASE_URL=https://<your-instance>.wandb.io

# An API key from THAT host: <host>/authorize (or User settings -> API keys)
export WANDB_API_KEY=

# Your team name: the <team> in <host>/<team>/... URLs. Runs land in <team>/<project>.
export WANDB_ENTITY=<your-team>
export WANDB_PROJECT=api-evals-101

# The three candidate models. Leave one blank and that model runs on the
# scripted mock instead (labelled '-mock'); see README.
export XAI_API_KEY=
export OPENAI_API_KEY=
export ANTHROPIC_API_KEY=

# Optional: override model IDs (run `python 00_check_setup.py` to see what works)
# export XAI_MODEL=grok-4.3
# export OPENAI_MODEL=gpt-5.4-mini
# export ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: the judge (a fixed model that is NOT one of the candidates)
# export JUDGE_PROVIDER=anthropic
# export JUDGE_MODEL=claude-haiku-4-5-20251001

# Optional
# export TRIALS=3        # run each row 3x to see noise
# export BACKEND=mock    # no API calls; plumbing check only
